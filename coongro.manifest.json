{
  "id": "purchases",
  "version": "0.2.0",
  "apiVersion": "2.0",
  "displayName": "Compras",
  "assets": {
    "styles": [
      "./dist/assets/tailwind.css",
      "./dist/assets/fontawesome/css/all.min.css"
    ]
  },
  "contributes": {
    "menus": [
      {
        "path": "Salidas",
        "order": 7,
        "icon": "assets/icons/cart.svg",
        "color": "#8b5cf6",
        "viewId": "purchases.salidas.open"
      },
      {
        "path": "Proveedores",
        "order": 8,
        "icon": "Store",
        "color": "#8b5cf6",
        "viewId": "purchases.proveedores.open"
      }
    ],
    "views": [
      {
        "id": "purchases.salidas.open",
        "title": "Salidas",
        "component": "./dist/views/compras/index.js",
        "export": "SalidasView"
      },
      {
        "id": "purchases.nuevo-proveedor.open",
        "title": "Proveedor",
        "component": "./dist/views/nuevo-proveedor/index.js",
        "export": "NuevoProveedorView"
      },
      {
        "id": "purchases.proveedores.open",
        "title": "Proveedores",
        "component": "./dist/views/proveedores/index.js",
        "export": "ProveedoresView"
      }
    ],
    "repositories": [
      {
        "module": "./dist/repositories/supplier.repository.js",
        "export": "SupplierRepository",
        "prefix": "purchases.suppliers"
      }
    ]
  }
}
